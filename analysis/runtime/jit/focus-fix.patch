+		// Otherwise they start at the focus window, and never propagate above it.
+		XWindowPtr wnd = focusAncestor(focus, pointer) ? pointer : focus;
 		while (wnd && !wnd->keyScreenCoords(key, x, y, pressed)) {
+			if (wnd == focus) {
+				break;
+			}
 			wnd = wnd->getParent();
 		}
 	}
