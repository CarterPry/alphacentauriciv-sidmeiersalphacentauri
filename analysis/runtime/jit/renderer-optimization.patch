+            // WASM memory is little-endian; ImageData expects R,G,B,opaque A.
+            rgba32[i] = 0xff000000 | (pixel & 0x0000ff00) |
+                ((pixel & 0x00ff0000) >>> 16) | ((pixel & 0x000000ff) << 16);
+        }
+        Module.boxedwinePresentSoftwareFrame(width, height, frame.rgba.buffer, presentState);
+        return;
