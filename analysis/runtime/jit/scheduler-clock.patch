--- a/source/kernel/kscheduler.cpp
+++ b/source/kernel/kscheduler.cpp
@@ -204,7 +204,14 @@
     // Guest threads can execute very different numbers of instructions
     // per millisecond. Share execution time rather than giving a fast thread
     // only a small fraction of the time used by a slower busy-polling thread.
-    const U64 sliceEnd = schedulerMicroCounter() + 1000;
+    const U64 sliceStart = schedulerMicroCounter();
+    const U64 sliceEnd = sliceStart + 1000;
+#ifdef __EMSCRIPTEN__
+    U64 lastClockTime = sliceStart;
+    U32 lastClockInstructionCount = 0;
+    U32 dispatchesSinceClock = 0;
+    U32 clockCheckDispatchBudget = 1;
+#endif
     contextTimeRemaining = contextTime;
 #ifndef __EMSCRIPTEN__
     try {
@@ -216,9 +223,37 @@
             break;
         }
 #endif
-        if (cpu->yield || schedulerMicroCounter() >= sliceEnd) {
+        if (cpu->yield) {
             break;
         }
+#ifdef __EMSCRIPTEN__
+        // Crossing WASM -> JS for every short dispatch can dominate execution.
+        // Learn only within this turn: slow batches immediately restore checks
+        // after every dispatch. Guest instruction and dispatch caps also bound
+        // fast batches. A newly slow batch can still overrun the 1 ms deadline;
+        // cooperative scheduling cannot preempt an in-flight cpu->run().
+        ++dispatchesSinceClock;
+        if (cpu->blockInstructionCount - lastClockInstructionCount >= 256 ||
+                dispatchesSinceClock >= clockCheckDispatchBudget) {
+            const U64 now = schedulerMicroCounter();
+            if (now >= sliceEnd) {
+                break;
+            }
+            const U64 batchTime = now - lastClockTime;
+            if (batchTime > 125) {
+                clockCheckDispatchBudget = 1;
+            } else if (batchTime < 32 && clockCheckDispatchBudget < 32) {
+                clockCheckDispatchBudget *= 2;
+            }
+            lastClockTime = now;
+            lastClockInstructionCount = cpu->blockInstructionCount;
+            dispatchesSinceClock = 0;
+        }
+#else
+        if (schedulerMicroCounter() >= sliceEnd) {
+            break;
+        }
+#endif
         if ((S32)cpu->blockInstructionCount >= contextTimeRemaining) {
             contextTimeRemaining = cpu->blockInstructionCount + contextTime;
         }
--- a/source/test/cpu/testCPU.cpp
+++ b/source/test/cpu/testCPU.cpp
@@ -37,6 +37,7 @@
 #ifdef BOXEDWINE_WASM_JIT
 #include "../../emulation/cpu/jit/jitCodeLifecycle.h"
 #endif
+#include <algorithm>
 #include <atomic>
 #include <cstdarg>
 #include <cstdio>
@@ -428,6 +429,116 @@
     if (cpu.dispatches != 1) {
         testFail("scheduler must preserve the test-end sentinel");
     }
+#ifdef __EMSCRIPTEN__
+    // Exercise the actual scheduler with a fake clock and guest dispatcher.
+    // Record clock-read positions so reduced clock traffic cannot hide a lost
+    // deadline, a delayed yield, or an unbounded low-instruction dispatch loop.
+    static U64 batchHostTime;
+    static U32 batchDispatches;
+    static std::vector<U32> clockAtDispatch;
+    class BatchCPU : public NormalCPU {
+    public:
+        BatchCPU(KMemory* memory) : NormalCPU(memory) { op.inst = Nop; }
+        DecodedOp* getOp(U32, U32) override { return &op; }
+        void run() override {
+            ++batchDispatches;
+            blockInstructionCount += instructionsPerDispatch;
+            batchHostTime += slowAfter && batchDispatches > slowAfter ? slowMicros : fastMicros;
+            yield = batchDispatches == yieldAfter || batchDispatches == 2000;
+        }
+        DecodedOp op;
+        U32 instructionsPerDispatch = 0;
+        U32 fastMicros = 1;
+        U32 slowAfter = 0;
+        U32 slowMicros = 40;
+        U32 yieldAfter = 0;
+    } batchCpu(context.memory);
+    batchCpu.thread = context.thread;
+    context.thread->cpu = &batchCpu;
+    setSchedulerTestClock([]() -> U64 {
+        clockAtDispatch.push_back(batchDispatches);
+        return batchHostTime;
+    });
+    auto resetBatch = [&]() {
+        batchHostTime = 0;
+        batchDispatches = 0;
+        clockAtDispatch.clear();
+        batchCpu.instructionsPerDispatch = 0;
+        batchCpu.fastMicros = 1;
+        batchCpu.slowAfter = 0;
+        batchCpu.slowMicros = 40;
+        batchCpu.yieldAfter = 0;
+        batchCpu.instructionCount = 0;
+    };
+
+    resetBatch();
+    runThreadSlice(context.thread);
+    const std::vector<U32> growth{0, 1, 3, 7, 15, 31, 63};
+    if (clockAtDispatch.size() < growth.size() ||
+            !std::equal(growth.begin(), growth.end(), clockAtDispatch.begin()) ||
+            batchDispatches != 1023 || batchHostTime != 1023) {
+        testFail("fast zero-instruction dispatches must grow bounded clock batches and still reach the deadline");
+    }
+    for (size_t i = growth.size(); i < clockAtDispatch.size(); ++i) {
+        if (clockAtDispatch[i] - clockAtDispatch[i - 1] != 32) {
+            testFail("low-instruction dispatches must read the clock at least every 32 calls");
+        }
+    }
+
+    resetBatch();
+    batchCpu.instructionsPerDispatch = 256;
+    batchCpu.fastMicros = 10;
+    runThreadSlice(context.thread);
+    if (batchDispatches != 100 || batchHostTime != 1000 ||
+            batchCpu.instructionCount != 25600 || clockAtDispatch.size() != 101) {
+        testFail("large JIT dispatches must check each call and stop at the 1 ms timestamp deadline");
+    }
+    for (size_t i = 0; i < clockAtDispatch.size(); ++i) {
+        if (clockAtDispatch[i] != i) {
+            testFail("a 256-instruction dispatch must force a fresh clock read");
+        }
+    }
+
+    resetBatch();
+    batchCpu.instructionsPerDispatch = 128;
+    batchCpu.fastMicros = 10;
+    runThreadSlice(context.thread);
+    if (clockAtDispatch.size() < 4 || clockAtDispatch[1] != 1 ||
+            clockAtDispatch[2] != 3 || clockAtDispatch[3] != 5 ||
+            batchDispatches != 101 || batchHostTime != 1010) {
+        testFail("instruction limits must accumulate and reset at each clock read");
+    }
+
+    resetBatch();
+    batchCpu.slowAfter = 7;
+    runThreadSlice(context.thread);
+    if (clockAtDispatch.size() < 6 || clockAtDispatch[3] != 7 ||
+            clockAtDispatch[4] != 15 || clockAtDispatch[5] != 16 ||
+            batchDispatches != 32 || batchHostTime != 1007) {
+        testFail("a newly slow batch must restore per-dispatch checks before the next deadline");
+    }
+    for (size_t i = 5; i < clockAtDispatch.size(); ++i) {
+        if (clockAtDispatch[i] - clockAtDispatch[i - 1] != 1) {
+            testFail("slow work must keep per-dispatch clock checks");
+        }
+    }
+
+    resetBatch();
+    batchCpu.instructionsPerDispatch = 1;
+    batchCpu.yieldAfter = 8;
+    runThreadSlice(context.thread);
+    if (batchDispatches != 8 || batchHostTime != 8 || !batchCpu.yield ||
+            batchCpu.instructionCount != 8 || clockAtDispatch != std::vector<U32>{0, 1, 3, 7}) {
+        testFail("yield must interrupt a growing batch immediately without an extra clock read");
+    }
+    clockAtDispatch.clear();
+    batchCpu.yieldAfter = 10;
+    runThreadSlice(context.thread);
+    if (batchDispatches != 10 || batchCpu.instructionCount != 10 ||
+            clockAtDispatch != std::vector<U32>{8, 9}) {
+        testFail("each new timed turn must restart with a one-dispatch clock budget");
+    }
+#endif
 #ifndef __EMSCRIPTEN__
     cpu.op.inst = Nop;
     cpu.raiseFault = true;
